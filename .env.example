# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pos_ecommerce_db?schema=public"

# Autenticacion
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# Servidor
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# MockPay Sandbox
MOCKPAY_BASE_URL="https://mockpay-backend.onrender.com"
MOCKPAY_PUBLIC_KEY="REPLACE_WITH_MOCKPAY_PUBLIC_KEY"
MOCKPAY_SECRET_KEY="REPLACE_WITH_MOCKPAY_SECRET_KEY"

# Administrador inicial (solo para ejecutar el seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="REPLACE_WITH_ADMIN_PASSWORD"
