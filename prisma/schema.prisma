generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CASHIER
  CUSTOMER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum PosSaleStatus {
  OPEN
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER_QR
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderSource {
  WEB
  MARKETPLACE
  MANUAL
}

enum OrderStatus {
  PENDING
  PAID
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ReservationStatus {
  NONE
  RESERVED
  CONSUMED
  RELEASED
}

enum PaymentProvider {
  MOCKPAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(CUSTOMER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer?

  cashSessions CashSession[]
  posSales     PosSale[]

  @@map("users")
}

model Customer {
  id        Int      @id @default(autoincrement())
  userId    Int?     @unique @map("user_id")
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  phone     String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses Address[]

  carts  Cart[]
  orders Order[]

  @@map("customers")
}

model Address {
  id             Int      @id @default(autoincrement())
  customerId     Int      @map("customer_id")
  recipientName  String   @map("recipient_name") @db.VarChar(150)
  recipientPhone String   @map("recipient_phone") @db.VarChar(20)
  addressLine    String   @map("address_line") @db.Text
  district       String   @db.VarChar(100)
  city           String   @db.VarChar(100)
  reference      String?  @db.Text
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@map("addresses")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.Text

  products Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @map("category_id")
  sku         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  costPrice   Decimal  @map("cost_price") @db.Decimal(12, 2)
  salePrice   Decimal  @map("sale_price") @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory Inventory?

  posSaleItems PosSaleItem[]

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model Inventory {
  id            Int      @id @default(autoincrement())
  productId     Int      @unique @map("product_id")
  stock         Int      @default(0)
  reservedStock Int      @default(0) @map("reserved_stock")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

model CashSession {
  id             Int               @id @default(autoincrement())
  cashierId      Int               @map("cashier_id")
  openingAmount  Decimal           @map("opening_amount") @db.Decimal(12, 2)
  openedAt       DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(3)
  status         CashSessionStatus @default(OPEN)
  expectedAmount Decimal?          @map("expected_amount") @db.Decimal(12, 2)
  countedAmount  Decimal?          @map("counted_amount") @db.Decimal(12, 2)
  difference     Decimal?          @db.Decimal(12, 2)

  cashier User      @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  sales   PosSale[]

  @@map("cash_sessions")
}

model PosSale {
  id            Int            @id @default(autoincrement())
  cashSessionId Int            @map("cash_session_id")
  cashierId     Int            @map("cashier_id")
  status        PosSaleStatus  @default(OPEN)
  paymentMethod PaymentMethod? @map("payment_method")
  total         Decimal        @default(0) @db.Decimal(12, 2)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  paidAt        DateTime?      @map("paid_at") @db.Timestamptz(3)

  cashSession CashSession   @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  cashier     User          @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items       PosSaleItem[]

  @@map("pos_sales")
}

model PosSaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int     @map("sale_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  unitCost  Decimal @map("unit_cost") @db.Decimal(12, 2)

  sale    PosSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([saleId, productId])
  @@map("pos_sale_items")
}

model Cart {
  id         Int        @id @default(autoincrement())
  customerId Int        @map("customer_id")
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    CartItem[]

  @@index([customerId, status])
  @@map("carts")
}

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int @map("cart_id")
  productId Int @map("product_id")
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                   Int               @id @default(autoincrement())
  customerId           Int               @map("customer_id")
  source               OrderSource
  status               OrderStatus       @default(PENDING)
  total                Decimal           @default(0) @db.Decimal(12, 2)
  currency             String            @default("USD") @db.VarChar(3)
  recipientName        String            @map("recipient_name") @db.VarChar(150)
  recipientPhone       String            @map("recipient_phone") @db.VarChar(20)
  shippingAddress      String            @map("shipping_address") @db.Text
  district             String            @db.VarChar(100)
  city                 String            @db.VarChar(100)
  reference            String?           @db.Text
  reservationStatus    ReservationStatus @default(NONE) @map("reservation_status")
  reservationExpiresAt DateTime?         @map("reservation_expires_at") @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([customerId, status])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  unitCost  Decimal @map("unit_cost") @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@map("order_items")
}

model Payment {
  id                Int             @id @default(autoincrement())
  orderId           Int             @map("order_id")
  provider          PaymentProvider @default(MOCKPAY)
  providerPaymentId String?         @unique @map("provider_payment_id") @db.VarChar(100)
  idempotencyKey    String          @unique @map("idempotency_key") @db.VarChar(100)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("USD") @db.VarChar(3)
  status            PaymentStatus   @default(PENDING)
  checkoutUrl       String?         @map("checkout_url") @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt       DateTime?       @map("confirmed_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@map("payments")
}
